    "test:planning-generation": "esbuild tests/planning_generation_receipt.test.ts --bundle --platform=node --format=cjs --outfile=.tmp-tests/planning_generation_receipt.test.cjs && node --test .tmp-tests/planning_generation_receipt.test.cjs",
    "test:editor-boot": "esbuild tests/editor_boot_lifecycle.test.ts --bundle --platform=node --format=cjs --outfile=.tmp-tests/editor_boot_lifecycle.test.cjs && node --test .tmp-tests/editor_boot_lifecycle.test.cjs",
    "export:cad-map-bridge": "esbuild src/frontend/scene/terrain_map_bridge.ts --bundle --format=iife --global-name=VectoplanTerrainMap --outfile=../vectoplan-cad/static/cad/js/terrain_map_bridge.js",
