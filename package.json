    "test:storey-system": "esbuild tests/storey_system.test.ts --bundle --platform=node --format=cjs --outfile=.tmp-tests/storey-system.test.cjs && node --test .tmp-tests/storey-system.test.cjs",
    "test:storey-drag": "esbuild tests/storey_drag.test.ts --bundle --platform=node --format=cjs --outfile=.tmp-tests/storey-drag.test.cjs && node .tmp-tests/storey-drag.test.cjs",
